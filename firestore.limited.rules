rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role(roles) { return signedIn() && profile().active == true && profile().role in roles; }
    function prepare() { return role(['admin', 'gerente', 'chefe_oficina']); }
    function postService() { return role(['admin', 'gerente', 'qualidade', 'consultor']); }
    function importHgsi() { return role(['admin', 'gerente', 'qualidade']); }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
        && request.resource.data.mustChangePassword == false;
    }
    match /vehiclesFlow/{id} {
      // One-document idempotency guard used only when adding a preparation.
      allow get: if prepare();
      // Post-service already queries deliveredAt by month. Active-flow queries fail.
      allow list: if postService() && resource.data.deliveredAt > timestamp.date(2000, 1, 1);
      allow create: if prepare() && request.resource.data.preparationMode == 'basic'
        && request.resource.data.currentLane == 'preparacao_confirmada'
        && request.resource.data.status == 'ativo';
    }
    match /flowEvents/{id} {
      allow create: if prepare()
        && id == 'basic-preparation-' + request.resource.data.vehicleFlowId
        && request.resource.data.toLane == 'preparacao_confirmada';
    }
    match /hgsiRecords/{id} {
      allow read: if postService();
      allow create, update: if importHgsi();
    }
    match /hgsiAnswers/{id} {
      allow read: if postService();
      allow create, update: if importHgsi();
    }
    match /postServiceCases/{id} {
      allow read, create, update: if postService();
    }
    match /importBatches/{id} {
      allow create: if importHgsi() && request.resource.data.sourceKind in ['hgsi_records', 'hgsi_answers'];
    }
    // Everything else (including parts/public lookup, old tabs and old writers) is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
