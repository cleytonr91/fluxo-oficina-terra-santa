rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && userProfile().data.active == true;
    }

    function hasRole(roles) {
      return activeUser() && userProfile().data.role in roles;
    }

    function manager() {
      return hasRole(['admin', 'gerente']);
    }

    function admin() {
      return hasRole(['admin']);
    }

    function operations() {
      return hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'tecnico', 'lider_lavagem', 'consultor_funilaria', 'estoquista', 'qualidade', 'agendamento']);
    }

    function hasCustomPath(path) {
      return activeUser()
        && userProfile().data.keys().hasAny(['allowedPaths'])
        && path in userProfile().data.allowedPaths;
    }

    function prepRole(roles) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }
    function prepRead() { return prepRole(['admin', 'gerente', 'chefe_oficina', 'garantista', 'estoquista']); }
    match /preparationPlans/{id} {
      allow get: if prepRead();
      allow list: if prepRead() && request.query.limit <= 201;
      allow create: if prepRole(['admin', 'gerente', 'chefe_oficina'])
        && request.resource.data.id == id && request.resource.data.date is string
        && request.resource.data.workshopVersion == 0 && request.resource.data.warrantyVersion == 0 && request.resource.data.partsVersion == 0
        && request.resource.data.sent == false && request.resource.data.warranty.status == 'pendente'
        && request.resource.data.warranty.campaigns.size() == 0 && request.resource.data.parts.ready == false
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (prepRole(['admin', 'gerente', 'chefe_oficina']) && resource.data.sent == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workshop','workshopVersion','workshopBy','updatedBy','updatedAt'])
            && request.resource.data.workshopVersion == resource.data.workshopVersion + 1)
          || (prepRole(['admin', 'gerente', 'garantista'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['warranty','warrantyVersion','warrantyBy','updatedBy','updatedAt'])
            && request.resource.data.warrantyVersion == resource.data.warrantyVersion + 1
            && request.resource.data.warranty.status in ['pendente','sem_pendencias','com_pendencias'])
          || (prepRole(['admin', 'gerente', 'estoquista'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parts','partsVersion','partsBy','updatedBy','updatedAt'])
            && request.resource.data.partsVersion == resource.data.partsVersion + 1)
          || (prepRole(['admin', 'gerente', 'chefe_oficina'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent','updatedBy','updatedAt'])
            && request.resource.data.sent == true
            && resource.data.workshop.technician is string && resource.data.workshop.technician.size() > 0
            && getAfter(/databases/$(database)/documents/vehiclesFlow/$(id)).data.appointmentId == id)
        );
    }
    match /preparationCampaigns/{id} {
      allow get: if prepRead();
      allow list: if prepRead() && request.query.limit <= 101;
      allow create: if prepRole(['admin', 'gerente', 'garantista'])
        && request.resource.data.id == id && request.resource.data.version == 1
        && request.resource.data.kind in ['campanha','recall'] && request.resource.data.parts is list
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if prepRole(['admin', 'gerente', 'garantista'])
        && request.resource.data.id == id && request.resource.data.version == resource.data.version + 1
        && request.resource.data.code == resource.data.code && request.resource.data.kind == resource.data.kind
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if activeUser() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.active == false;
      allow update: if manager();
      allow delete: if false;
    }

    match /agendaItems/{document} {
      allow read: if operations() && (resource.data.kind == 'holiday' || manager() || resource.data.ownerId == request.auth.uid || (resource.data.keys().hasAny(['participantIds']) && request.auth.uid in resource.data.participantIds));
      allow create: if operations() && request.resource.data.ownerId == request.auth.uid && (request.resource.data.kind != 'time_off' && request.resource.data.kind != 'holiday' || admin());
      allow update: if operations() && (resource.data.kind != 'time_off' && resource.data.kind != 'holiday' || admin()) && (resource.data.ownerId == request.auth.uid || manager());
      allow delete: if operations() && ((resource.data.kind == 'time_off' || resource.data.kind == 'holiday') ? admin() : (resource.data.ownerId == request.auth.uid || manager()));
    }

    match /actionPlans/{document} {
      allow read: if operations() && (manager() || resource.data.createdBy == request.auth.uid || (resource.data.keys().hasAny(['responsibleIds']) && request.auth.uid in resource.data.responsibleIds));
      allow create: if operations() && request.resource.data.createdBy == request.auth.uid;
      allow update: if operations() && (manager() || resource.data.createdBy == request.auth.uid || (resource.data.keys().hasAny(['responsibleIds']) && request.auth.uid in resource.data.responsibleIds));
      allow delete: if operations() && (manager() || resource.data.createdBy == request.auth.uid);
    }

    match /importBatches/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'qualidade']);
    }

    match /appointments/{document} {
      allow read: if operations();
      allow write: if operations();
    }

    match /preparations/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina']);
    }

    match /vehiclesFlow/{document} {
      allow read: if operations();
      allow create: if operations()
        && (hasRole(['admin', 'gerente', 'chefe_oficina'])
          || !request.resource.data.keys().hasAny([
            'vehicleImmobilized',
            'immobilizationReason',
            'immobilizationUpdatedBy',
            'immobilizationUpdatedAt'
          ]));
      allow update: if operations()
        && (hasRole(['admin', 'gerente', 'chefe_oficina'])
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'vehicleImmobilized',
            'immobilizationReason',
            'immobilizationUpdatedBy',
            'immobilizationUpdatedAt'
          ]))
        && (hasRole(['admin', 'consultor'])
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'customerWaits',
            'customerWaitsUpdatedBy',
            'customerWaitsUpdatedAt'
          ])
          || (resource.data.currentLane == 'preparacao_confirmada'
            && request.resource.data.currentLane != 'preparacao_confirmada'));
      allow delete: if false;
    }

    match /walkInCustomers/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'consultor', 'chefe_oficina']);
    }

    match /flowEvents/{document} {
      allow read: if operations();
      allow write: if operations();
    }

    match /complementaryBudgets/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'estoquista', 'tecnico', 'chefe_oficina']);
    }

    match /partOrders/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'consultor_funilaria', 'estoquista', 'agendamento']);
    }

    match /partsCounterEntries/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'consultor', 'consultor_funilaria', 'estoquista']);
    }

    match /partsSalesGoals/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'estoquista']);
    }

    match /farolObservations/{document} {
      allow read: if activeUser();
      allow write: if hasRole(['admin']);
    }

    match /farolDailyResults/{document} {
      allow read: if activeUser();
      allow write: if hasRole(['admin']);
    }

    match /farolRevenue/{document} {
      allow read: if activeUser();
      allow write: if hasRole(['admin']);
    }

    match /farolGrossProfit/{document} {
      allow read: if activeUser();
      allow write: if hasRole(['admin']);
    }

    match /farolChannelRevenue/{document} {
      allow read: if activeUser();
      allow write: if hasRole(['admin']);
    }

    match /farolServiceProductivity/{document} {
      allow read: if activeUser();
      allow write: if hasRole(['admin']);
    }

    match /farolMonthlyPlans/{document} {
      allow read: if activeUser();
      allow write: if hasRole(['admin']);
    }

    match /partsCatalog/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin']);
    }

    match /inventoryItems/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'estoquista']) || hasCustomPath('/estoque');
    }

    match /inventorySuppliers/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'estoquista']) || hasCustomPath('/estoque');
    }

    match /publicPartLookups/{document} {
      allow get: if true;
      allow list: if false;
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'consultor_funilaria', 'estoquista', 'agendamento']);
    }

    match /deliveries/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'consultor']);
    }

    match /postServiceCases/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'qualidade', 'consultor']);
    }

    match /hgsiRecords/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'qualidade']);
    }

    match /hgsiAnswers/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'qualidade']);
    }

    match /bodyShopProcesses/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'consultor_funilaria', 'estoquista']);
    }
  }
}
