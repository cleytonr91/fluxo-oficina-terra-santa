rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && userProfile().data.active == true;
    }

    function hasRole(roles) {
      return activeUser() && userProfile().data.role in roles;
    }

    function manager() {
      return hasRole(['admin', 'gerente']);
    }

    function operations() {
      return hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'tecnico', 'lider_lavagem', 'consultor_funilaria', 'estoquista', 'qualidade', 'agendamento']);
    }

    match /users/{userId} {
      allow read: if activeUser() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.active == false;
      allow update: if manager();
      allow delete: if false;
    }

    match /agendaItems/{document} {
      allow read: if operations() && (manager() || resource.data.ownerId == request.auth.uid || (resource.data.keys().hasAny(['participantIds']) && request.auth.uid in resource.data.participantIds));
      allow create: if operations() && request.resource.data.ownerId == request.auth.uid;
      allow update: if operations() && (resource.data.ownerId == request.auth.uid || manager());
      allow delete: if operations() && (resource.data.ownerId == request.auth.uid || manager());
    }

    match /importBatches/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina']);
    }

    match /appointments/{document} {
      allow read: if operations();
      allow write: if operations();
    }

    match /preparations/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina']);
    }

    match /vehiclesFlow/{document} {
      allow read: if operations();
      allow create: if operations()
        && (hasRole(['admin', 'gerente', 'chefe_oficina'])
          || !request.resource.data.keys().hasAny([
            'vehicleImmobilized',
            'immobilizationReason',
            'immobilizationUpdatedBy',
            'immobilizationUpdatedAt'
          ]));
      allow update: if operations()
        && (hasRole(['admin', 'gerente', 'chefe_oficina'])
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'vehicleImmobilized',
            'immobilizationReason',
            'immobilizationUpdatedBy',
            'immobilizationUpdatedAt'
          ]))
        && (hasRole(['admin'])
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'customerWaits',
            'customerWaitsUpdatedBy',
            'customerWaitsUpdatedAt'
          ])
          || (resource.data.currentLane == 'preparacao_confirmada'
            && request.resource.data.currentLane != 'preparacao_confirmada'));
      allow delete: if false;
    }

    match /walkInCustomers/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'consultor', 'chefe_oficina']);
    }

    match /flowEvents/{document} {
      allow read: if operations();
      allow write: if operations();
    }

    match /complementaryBudgets/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'estoquista', 'tecnico', 'chefe_oficina']);
    }

    match /partOrders/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'consultor_funilaria', 'estoquista', 'agendamento']);
    }

    match /partsCounterEntries/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'consultor', 'consultor_funilaria', 'estoquista']);
    }

    match /partsSalesGoals/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'estoquista']);
    }

    match /farolObservations/{document} {
      allow read: if manager();
      allow write: if manager();
    }

    match /farolDailyResults/{document} {
      allow read: if manager();
      allow write: if manager();
    }

    match /partsCatalog/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin']);
    }

    match /publicPartLookups/{document} {
      allow get: if true;
      allow list: if false;
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'consultor_funilaria', 'estoquista', 'agendamento']);
    }

    match /deliveries/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'consultor']);
    }

    match /postServiceCases/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'qualidade', 'consultor']);
    }

    match /hgsiRecords/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'qualidade']);
    }

    match /hgsiAnswers/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'qualidade']);
    }

    match /bodyShopProcesses/{document} {
      allow read: if operations();
      allow write: if hasRole(['admin', 'gerente', 'chefe_oficina', 'consultor', 'consultor_funilaria', 'estoquista']);
    }
  }
}
